# Required: your Chess.com username
CHESSCOM_USERNAME=yourusername

# Optional: IANA timezone used to render game dates in Notion
# Defaults to America/Los_Angeles
TIMEZONE=America/Los_Angeles

# Only needed for the remove-legacy-properties script
# NOTION_API_TOKEN=secret_xxx
# NOTION_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
